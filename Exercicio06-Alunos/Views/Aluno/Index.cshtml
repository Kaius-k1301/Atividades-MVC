@model IEnumerable<AtividadesMVC.Kaius.Exercicio06.Models.Aluno>
@{ ViewData["Title"] = "Alunos cadastrados"; }
<h1>Alunos cadastrados</h1>
<p>Lista criada em memória no Controller.</p>
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>ID</th><th>Nome</th><th>Idade</th><th>Curso</th><th>Ação</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
                <td>@item.Id</td>
                <td>@item.Nome</td>
                <td>@item.Idade</td>
                <td>@item.Curso</td>
                <td><a class="btn btn-sm btn-outline-primary" asp-action="Detalhes" asp-route-id="@item.Id">Detalhes</a></td>
        </tr>
    }
    </tbody>
</table>
</div>
