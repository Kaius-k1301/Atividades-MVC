@model IEnumerable<AtividadesMVC.Kaius.Exercicio15.Models.Funcionario>
@{ ViewData["Title"] = "Funcionários da empresa"; }
<h1>Funcionários da empresa</h1>
<p></p>
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>ID</th><th>Nome</th><th>Cargo</th><th>Departamento</th><th>Salário</th><th>Situação</th><th>Classificação</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
                <td>@item.Id</td>
                <td>@item.Nome</td>
                <td>@item.Cargo</td>
                <td>@item.Departamento</td>
                <td>@item.Salario.ToString("C")</td>
                <td>@item.Situacao</td>
                <td>@item.FaixaSalarial</td>
        </tr>
    }
    </tbody>
</table>
</div>
