@model IEnumerable<AtividadesMVC.Kaius.Exercicio10.Models.Eletronico>
@{ ViewData["Title"] = "Lista completa"; }
<h1>Lista completa</h1>
<p></p>
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>Nome</th><th>Marca</th><th>Categoria</th><th>Preço</th><th>Estoque</th><th>Situação</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
                <td>@item.Nome</td>
                <td>@item.Marca</td>
                <td>@item.Categoria</td>
                <td>@item.Preco.ToString("C")</td>
                <td>@item.Estoque</td>
                <td>@item.Situacao</td>
        </tr>
    }
    </tbody>
</table>
</div>
