<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Academia - Kaius</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Academia" asp-action="Index">Academia - Kaius</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="menu"><ul class="navbar-nav ms-auto"><li class="nav-item"><a class="nav-link" asp-controller="Academia" asp-action="Index">Início</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Academia" asp-action="Musculacao">Musculação</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Academia" asp-action="Cardio">Cardio</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Academia" asp-action="Planos">Planos</a></li></ul></div>
    </div>
</nav>
<main class="container pb-5">@RenderBody()</main>
<footer class="border-top py-3"><div class="container">Atividade MVC de Kaius</div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
