@model IEnumerable<AtividadesMVC.Kaius.Exercicio08.Models.Livro>
@{ ViewData["Title"] = "Livros disponíveis"; }
<h1>Livros disponíveis</h1>
<p></p>
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>Título</th><th>Autor</th><th>Ano</th><th>Situação</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
                <td>@item.Titulo</td>
                <td>@item.Autor</td>
                <td>@item.Ano</td>
                <td>@item.Situacao</td>
        </tr>
    }
    </tbody>
</table>
</div>
