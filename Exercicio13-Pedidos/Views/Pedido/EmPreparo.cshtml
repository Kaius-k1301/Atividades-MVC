@model IEnumerable<AtividadesMVC.Kaius.Exercicio13.Models.Pedido>
@{ ViewData["Title"] = "Pedidos em preparo"; }
<h1>Pedidos em preparo</h1>
<p></p>
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>ID</th><th>Cliente</th><th>Produto</th><th>Quantidade</th><th>Unitário</th><th>Total</th><th>Status</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
                <td>@item.Id</td>
                <td>@item.Cliente</td>
                <td>@item.Produto</td>
                <td>@item.Quantidade</td>
                <td>@item.PrecoUnitario.ToString("C")</td>
                <td>@item.ValorTotal.ToString("C")</td>
                <td>@item.Status</td>
        </tr>
    }
    </tbody>
</table>
</div>
