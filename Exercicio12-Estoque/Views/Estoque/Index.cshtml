@model IEnumerable<AtividadesMVC.Kaius.Exercicio12.Models.Produto>
@{ ViewData["Title"] = "Lista geral do estoque"; }
<h1>Lista geral do estoque</h1>
<p></p>
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>Produto</th><th>Categoria</th><th>Estoque</th><th>Mínimo</th><th>Preço</th><th>Situação</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
                <td>@item.Nome</td>
                <td>@item.Categoria</td>
                <td>@item.Estoque</td>
                <td>@item.EstoqueMinimo</td>
                <td>@item.Preco.ToString("C")</td>
                <td>@item.Situacao</td>
        </tr>
    }
    </tbody>
</table>
</div>
