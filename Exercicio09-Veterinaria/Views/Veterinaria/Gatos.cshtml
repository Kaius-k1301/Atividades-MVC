@model IEnumerable<AtividadesMVC.Kaius.Exercicio09.Models.Animal>
@{ ViewData["Title"] = "Gatos cadastrados"; }
<h1>Gatos cadastrados</h1>
<p></p>
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>ID</th><th>Nome</th><th>Espécie</th><th>Idade</th><th>Dono</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
                <td>@item.Id</td>
                <td>@item.Nome</td>
                <td>@item.Especie</td>
                <td>@item.Idade</td>
                <td>@item.Dono</td>
        </tr>
    }
    </tbody>
</table>
</div>
