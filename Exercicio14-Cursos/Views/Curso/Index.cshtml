@model IEnumerable<AtividadesMVC.Kaius.Exercicio14.Models.Curso>
@{ ViewData["Title"] = "Cursos profissionalizantes"; }
<h1>Cursos profissionalizantes</h1>
<p>Resumo da oferta de cursos e tabela completa.</p><div class="row g-3 mb-4">
<div class="col"><div class="card"><div class="card-body"><strong>Total:</strong> @ViewBag.Total</div></div></div>
<div class="col"><div class="card"><div class="card-body"><strong>Disponíveis:</strong> @ViewBag.Disponiveis</div></div></div>
<div class="col"><div class="card"><div class="card-body"><strong>Lotados:</strong> @ViewBag.Lotados</div></div></div>
<div class="col"><div class="card"><div class="card-body"><strong>Online:</strong> @ViewBag.Online</div></div></div>
<div class="col"><div class="card"><div class="card-body"><strong>Presenciais:</strong> @ViewBag.Presenciais</div></div></div>
</div>

<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>Curso</th><th>Carga horária</th><th>Modalidade</th><th>Vagas</th><th>Valor</th><th>Situação</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
                <td>@item.Nome</td>
                <td>@(item.CargaHoraria + " h")</td>
                <td>@item.Modalidade</td>
                <td>@item.Vagas</td>
                <td>@item.Valor.ToString("C")</td>
                <td>@item.Situacao</td>
        </tr>
    }
    </tbody>
</table>
</div>
