@model IEnumerable<AtividadesMVC.Kaius.Exercicio14.Models.Curso>
@{ ViewData["Title"] = "Cursos com inscrições abertas"; }
<h1>Cursos com inscrições abertas</h1>
<p></p>
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>Curso</th><th>Carga horária</th><th>Modalidade</th><th>Vagas</th><th>Valor</th><th>Situação</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
                <td>@item.Nome</td>
                <td>@(item.CargaHoraria + " h")</td>
                <td>@item.Modalidade</td>
                <td>@item.Vagas</td>
                <td>@item.Valor.ToString("C")</td>
                <td>@item.Situacao</td>
        </tr>
    }
    </tbody>
</table>
</div>
